# TraceAPL runtime settings
TRACEAPL_HOST=0.0.0.0
TRACEAPL_PORT=5000
TRACEAPL_SSL=adhoc
TRACEAPL_SECRET_KEY=replace-with-a-long-random-string
TRACEAPL_ADMIN_PASSWORD=replace-with-admin-password

# Employee autocomplete mode: mock or rest
TRACEAPL_EMPLOYEE_LOOKUP_MODE=mock

# Denodo REST employee lookup settings.
# Do not put real passwords in GitLab. Copy this to a local .env or export these variables locally.
DENODO_EMPLOYEE_REST_URL=https://denodo.jhuapl.edu:9443/denodo-restfulws/addit/views/dim_hr_person
DENODO_USERNAME=your-denodo-username
DENODO_PASSWORD=your-denodo-password
DENODO_VERIFY_SSL=1
DENODO_TIMEOUT_SECONDS=12
DENODO_EMPLOYEE_LIMIT=10

# Field mapping for dim_hr_person. Adjust only if the Denodo view changes.
DENODO_EMPLOYEE_NAME_FIELD=preferred_full_name
DENODO_EMPLOYEE_FALLBACK_NAME_FIELD=full_name
DENODO_EMPLOYEE_EMAIL_FIELD=email_id
DENODO_EMPLOYEE_ID_FIELD=person_num
DENODO_EMPLOYEE_USER_FIELD=user_id
DENODO_EMPLOYEE_STATUS_FIELD=person_status_code
DENODO_EMPLOYEE_ACTIVE_VALUE=A
DENODO_EMPLOYEE_REQUIRE_EMAIL=1
DENODO_EMPLOYEE_USE_SERVER_FILTER=1
